---
import Icon from './Icon.astro';
import { RADIO } from '../config';
import { langFromUrl, useT, href } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = useT(lang);

interface Props { full?: boolean }
const { full = false } = Astro.props;
---
<section class:list={['rband', { 'rband--full': full }]} aria-labelledby="rband-h">
  <div class="wrap rband__in">
    <div class="rband__vinyl" aria-hidden="true">
      <div class="rband__disc">
        <span class="rband__label display">{RADIO.station.split(' ')[0]}<small>FM</small></span>
      </div>
    </div>
    <div class="rband__text">
      <p class="cond rband__kicker"><span class="dot-live"></span> {t.radio.onAir} · {RADIO.station}</p>
      <h2 id="rband-h" class="display rband__title">{t.radio.title1} <span class="grad-text">{t.radio.title2}</span></h2>
      <p class="rband__lead">{t.radio.lead}</p>
      <div class="rband__player">
        <button class="rband__play" data-radio-toggle aria-label={`${RADIO.title} ${t.radio.play}`}>
          <span class="i-play"><Icon name="play" size={26} /></span>
          <span class="i-pause"><Icon name="pause" size={26} /></span>
        </button>
        <div class="rband__track">
          <b>{RADIO.title}</b>
          <span class="muted">{RADIO.artist}</span>
          <div class="rband__wave" aria-hidden="true">
            {Array.from({ length: 48 }, (_, i) => <i style={`--h:${20 + ((i * 37) % 70)}%;--i:${i}`}></i>)}
          </div>
        </div>
      </div>
      {!full && <a href={href(lang, '/radio/')} class="sec-head__link">{t.radio.more} <Icon name="arrow" /></a>}
    </div>
  </div>
</section>

<style>
  .rband {
    position: relative;
    margin-block: clamp(30px, 6vw, 80px);
    padding-block: clamp(50px, 8vw, 110px);
    background:
      radial-gradient(60% 120% at 20% 50%, rgba(255, 45, 135, 0.22), transparent 60%),
      radial-gradient(50% 120% at 90% 50%, rgba(139, 61, 255, 0.25), transparent 60%),
      #0a0710;
    border-block: 1px solid var(--line);
    overflow: hidden;
  }
  .rband--full { margin-top: 0; }
  .rband__in { display: grid; grid-template-columns: auto 1fr; gap: clamp(30px, 6vw, 90px); align-items: center; }
  .rband__vinyl { width: clamp(220px, 30vw, 380px); aspect-ratio: 1; position: relative; }
  .rband__disc {
    width: 100%; height: 100%;
    border-radius: 50%;
    background:
      radial-gradient(circle, transparent 0 17%, #000 17.5% 18.5%, transparent 19%),
      repeating-radial-gradient(circle, #121016 0 2px, #1d1a22 2px 3px),
      #111;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.06), 0 0 80px rgba(255, 45, 135, 0.25);
    display: grid;
    place-items: center;
    animation: spin 5s linear infinite;
    animation-play-state: paused;
  }
  :global(html[data-radio='playing']) .rband__disc { animation-play-state: running; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .rband__label {
    width: 34%; aspect-ratio: 1; border-radius: 50%;
    background: var(--sunset);
    color: #120812;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-size: clamp(1rem, 2vw, 1.5rem);
    line-height: 0.9;
  }
  .rband__label small { font-size: 0.6em; }
  .rband__kicker { display: flex; align-items: center; gap: 8px; color: var(--pink); margin: 0 0 12px; }
  .rband__kicker .dot-live { background: var(--pink); }
  .rband__title { font-size: clamp(2.6rem, 6vw, 5rem); }
  .rband__lead { color: #d9d2e4; max-width: 520px; margin: 18px 0 26px; font-size: 1.1rem; }
  .rband__player {
    display: flex; align-items: center; gap: 18px;
    padding: 14px; max-width: 560px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line2);
    margin-bottom: 22px;
  }
  .rband__play {
    flex: none; width: 66px; height: 66px; display: grid; place-items: center;
    background: var(--sunset); color: #120812;
    clip-path: polygon(0 0, 100% 0, 100% 75%, 75% 100%, 0 100%);
    transition: transform 0.2s;
  }
  .rband__play:hover { transform: scale(1.05); }
  .i-pause { display: none; }
  :global(html[data-radio='playing']) .i-play { display: none; }
  :global(html[data-radio='playing']) .i-pause { display: block; }
  .rband__track { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .rband__track b { font-family: var(--f-cond); font-size: 1.3rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .rband__wave { display: flex; align-items: center; gap: 2px; height: 34px; margin-top: 6px; }
  .rband__wave i {
    flex: 1; height: var(--h); background: rgba(255, 255, 255, 0.2);
    transform-origin: center;
  }
  :global(html[data-radio='playing']) .rband__wave i {
    background: var(--pink);
    animation: wave 0.8s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.07s);
  }
  @keyframes wave { from { transform: scaleY(0.35); } to { transform: scaleY(1); } }
  @media (max-width: 760px) {
    .rband__in { grid-template-columns: 1fr; justify-items: start; }
    .rband__vinyl { width: 200px; }
  }
</style>
