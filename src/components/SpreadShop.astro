---
// Kasse über das offizielle Spreadshop-Modul (iframe von Spreadshirt).
// 18.11.2026 umgebaut (Mike: "das schaut maximal komisch aus"): Die eigene Produktübersicht (MerchGrid) ist das Schaufenster.
// Der weiße Spreadshop erscheint NUR, wenn ein Produkt, der Warenkorb oder die Kasse offen ist (Route #!/...).
// Geht der Besucher im Shop auf "Home" zurück (#!/), klappt das Modul wieder zu.
// Alte Produktlinks auf entfernte oder noch geprüfte Designs (merchDeadIds) zeigen sonst "Page not found":
// die werden abgefangen und auf die Übersicht umgeleitet, mit kurzem Hinweis.
// Datenschutz: Das Modul lädt erst, wenn jemand bei einem Produkt auf "Kaufen" klickt (dann gelten Spreadshirts Cookies).
import { MERCH } from '../config';
import { merchDeadIds } from '../data/merch';
interface Props { lang?: 'de' | 'en' }
const { lang = 'de' } = Astro.props;
const shopName = MERCH.url.match(/\/\/([^.]+)\.myspreadshop/)?.[1] ?? '';
const base = MERCH.url.replace(/\/$/, '');
const T = {
  de: {
    gone: 'Dieses Produkt gibt es so nicht mehr im Shop. Hier sind alle aktuellen Teile.',
    back: 'Zur Übersicht',
    privacy: 'Größen, Warenkorb und Kasse kommen von Spreadshirt (sprd.net AG), dort gelten deren Cookies.',
    privacyLink: 'Datenschutz',
  },
  en: {
    gone: 'This product is no longer in the store. Here is everything that is available right now.',
    back: 'Back to all products',
    privacy: 'Sizes, cart and checkout are provided by Spreadshirt (sprd.net AG); their cookies apply.',
    privacyLink: 'Privacy policy',
  },
}[lang];
---
{shopName && (
  <>
    <p class="sshop-gone" data-sshop-gone hidden>{T.gone}</p>
    <section class="sshop" id="merch" data-sshop data-shop={shopName} data-base={base}
      data-locale={lang === 'en' ? 'en_GB' : 'de_AT'} data-dead={JSON.stringify(merchDeadIds())}>
      <div class="sshop__bar">
        <a class="sshop__back cond" href="#!/" data-sshop-close>← {T.back}</a>
        <span class="sshop__privacy">{T.privacy} <a href="/datenschutz/">{T.privacyLink}</a></span>
      </div>
      <div id="myShop" class="sshop__embed" data-sshop-mount></div>
    </section>
  </>
)}

<script>
  const KEY = 'sshop-consent';
  const route = () => { try { return decodeURIComponent(location.hash); } catch { return location.hash; } };
  const isShopRoute = () => location.hash.startsWith('#!/');
  const isHome = () => /^#!\/?(\?.*)?$/.test(location.hash);
  function isDead(root: HTMLElement) {
    const r = route().toLowerCase();
    if (!isShopRoute()) return false;
    let dead: string[] = [];
    try { dead = JSON.parse(root.dataset.dead || '[]'); } catch { /* ignore */ }
    return r.includes('nordwald') || dead.some((id) => r.includes(id));
  }
  function load(root: HTMLElement) {
    if (root.dataset.loaded) return;
    root.dataset.loaded = '1';
    (window as any).spread_shop_config = {
      shopName: root.dataset.shop,
      locale: root.dataset.locale,
      prefix: root.dataset.base, // wie auf eldruna.com: Prefix = Spreadshop-Adresse
      baseId: 'myShop',
      updateMetadata: false, // Titel und Beschreibung der Seite nicht vom Shop überschreiben lassen
    };
    const s = document.createElement('script');
    s.src = `${root.dataset.base}/shopfiles/shopclient/shopclient.nocache.js`;
    s.async = true;
    document.body.appendChild(s);
  }
  const grid = () => document.getElementById('produkte');
  function close(root: HTMLElement) {
    root.classList.remove('is-open');
  }
  function open(root: HTMLElement) {
    try { localStorage.setItem(KEY, '1'); } catch { /* ignore */ }
    const gone = document.querySelector<HTMLElement>('[data-sshop-gone]');
    if (gone) gone.hidden = true;
    load(root);
    const wasOpen = root.classList.contains('is-open');
    root.classList.add('is-open');
    if (!wasOpen) setTimeout(() => root.scrollIntoView({ behavior: 'smooth', block: 'start' }), 60);
  }
  function showGone(root: HTMLElement) {
    history.replaceState(null, '', location.pathname + location.search);
    close(root);
    const gone = document.querySelector<HTMLElement>('[data-sshop-gone]');
    const g = grid();
    if (gone) {
      if (g && gone.nextElementSibling !== g.firstElementChild) g.prepend(gone); // Hinweis direkt über die Produkte
      gone.hidden = false;
    }
    setTimeout(() => (g ?? gone)?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 60);
  }
  function sync(root: HTMLElement) {
    if (!isShopRoute()) { close(root); return; }
    if (isDead(root)) { showGone(root); return; }
    if (isHome()) {
      if (root.classList.contains('is-open')) {
        close(root);
        setTimeout(() => grid()?.scrollIntoView({ behavior: 'smooth', block: 'start' }), 60);
      }
      return;
    }
    open(root);
  }
  function init() {
    const root = document.querySelector<HTMLElement>('[data-sshop]');
    if (!root) return;
    sync(root);
    // Die Adresse ändert sich auf drei Wegen: hashchange, Astros Seiten-Router (pushState ohne hashchange)
    // und der Spreadshop selbst. Deshalb zusätzlich alle 400 ms vergleichen.
    if (!(window as any).__sshopHash) {
      (window as any).__sshopHash = true;
      let last = location.href;
      const check = () => {
        if (location.href === last) return;
        last = location.href;
        const r = document.querySelector<HTMLElement>('[data-sshop]');
        if (r) sync(r);
      };
      window.addEventListener('hashchange', check);
      window.addEventListener('popstate', check);
      setInterval(check, 400);
    }
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .sshop { display: none; scroll-margin-top: calc(var(--header-h) + var(--ticker-h) + 20px); }
  .sshop.is-open { display: block; }
  .sshop__bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 18px; padding: 12px 0; }
  .sshop__back { font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
  .sshop__back:hover { color: var(--pink); }
  .sshop__privacy { font-size: 0.8rem; color: var(--dim); }
  .sshop__privacy a { text-decoration: underline; }
  .sshop__embed { min-height: 600px; background: #fff; border-radius: 4px; overflow: hidden; }
  .sshop-gone { margin: 0 0 18px; padding: 12px 16px; border: 1px solid var(--line2); border-left: 3px solid var(--pink); background: rgba(255, 42, 140, 0.06); }
</style>
