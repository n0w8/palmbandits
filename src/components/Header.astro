---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { GAMES } from '../data/games';
import { CATEGORIES, catL } from '../data/categories';
import { SITE, discordFor } from '../config';
import { langFromUrl, useT, href, deFromEn } from '../i18n';

interface Props { alt?: string | null }
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const h = (p: string) => href(lang, p);
const path = Astro.url.pathname;
const is = (p: string) => (p === h('/') ? path === p : path.startsWith(p));
const NAV = [
  { href: h('/news/'), label: t.nav.news },
  { href: h('/guides/'), label: t.nav.guides },
  { href: h('/spiele/'), label: t.nav.games, mega: true },
  { href: h('/cheats/'), label: t.nav.cheats },
  { href: h('/radio/'), label: t.nav.radio },
  { href: h('/community/'), label: t.nav.community },
  { href: h('/shop/'), label: t.nav.shop, badge: t.nav.newBadge },
];
// Sprachumschalter: Ziel ist die passende Seite der anderen Sprache (null = keine Uebersetzung, dann Startseite)
const altProp = Astro.props.alt;
const switchTo = altProp ? altProp : altProp === null ? (lang === 'de' ? '/en/' : '/') : lang === 'de' ? href('en', path) : deFromEn(path);
---
<header class="hdr" data-hdr>
  <div class="hdr__in wrap">
    <Logo />
    <nav class="hdr__nav" aria-label={t.nav.main}>
      {NAV.map((n) => (
        <div class:list={['hdr__item', { 'has-mega': n.mega }]}>
          <a href={n.href} class:list={['hdr__link', { 'is-active': is(n.href) }]}>
            {n.label}
            {n.badge && <em>{n.badge}</em>}
          </a>
          {n.mega && (
            <div class="mega">
              <div class="mega__games">
                {GAMES.map((g) => (
                  <a href={h(`/spiele/${g.slug}/`)} class="mega__game" style={`--g-from:${g.from};--g-to:${g.to}`}>
                    <span class="mega__num display">{g.numeral}</span>
                    <span class="mega__name">{g.name}<small>{g.year}</small></span>
                  </a>
                ))}
              </div>
              <div class="mega__cats">
                <p class="cond muted">{t.nav.topics}</p>
                {CATEGORIES.map((c) => (
                  <a href={h(c.slug === 'cheats' ? '/cheats/' : `/guides/kategorie/${c.slug}/`)}><Icon name={c.icon} size={16} />{catL(c.slug, lang).label}</a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>
    <div class="hdr__actions">
      <a class="hdr__lang cond" href={switchTo} hreflang={lang === 'de' ? 'en' : 'de'} title={t.nav.langSwitch} data-astro-reload>{t.nav.langShort}</a>
      <button class="hdr__search" data-search-open aria-label={t.nav.openSearch}>
        <Icon name="search" />
        <span>{t.nav.search}</span>
        <kbd>/</kbd>
      </button>
      <a class="btn btn--discord hdr__discord" {...discordFor(lang)}>
        <Icon name="discord" /> Discord
      </a>
      <button class="hdr__burger" data-menu-open aria-label={t.nav.openMenu} aria-expanded="false">
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<div class="mmenu" data-menu hidden>
  <div class="mmenu__top wrap">
    <Logo />
    <button data-menu-close aria-label={t.nav.closeMenu}><Icon name="close" size={28} /></button>
  </div>
  <nav class="mmenu__nav wrap" aria-label={t.nav.mobile}>
    {NAV.map((n, i) => (
      <a href={n.href} style={`--i:${i}`} class="display">
        {n.label}
        {n.badge && <em class="cond">{n.badge}</em>}
      </a>
    ))}
  </nav>
  <div class="mmenu__games wrap">
    {GAMES.map((g) => (
      <a href={h(`/spiele/${g.slug}/`)} class="chip chip--game" style={`--g-from:${g.from};--g-to:${g.to}`}>{g.name}</a>
    ))}
  </div>
  <div class="wrap mmenu__cta">
    <a class="btn btn--discord" {...discordFor(lang)}><Icon name="discord" /> {t.nav.joinDiscord}</a>
    <a class="btn btn--ghost" href={switchTo} data-astro-reload>{t.nav.langSwitch}</a>
  </div>
</div>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgba(7, 6, 11, 0.72);
    backdrop-filter: blur(18px) saturate(1.4);
    -webkit-backdrop-filter: blur(18px) saturate(1.4);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s, background 0.3s;
  }
  :global(.hdr.is-scrolled) { border-color: var(--line); background: rgba(7, 6, 11, 0.9); }
  .hdr__in { height: 100%; display: flex; align-items: center; gap: 28px; }
  .hdr__nav { display: flex; gap: 2px; margin-right: auto; }
  .hdr__item { position: relative; }
  .hdr__link {
    display: flex; align-items: center; gap: 6px;
    padding: 10px 12px;
    font-family: var(--f-cond);
    font-weight: 700;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--muted);
    position: relative;
    transition: color 0.2s;
  }
  .hdr__link::after {
    content: '';
    position: absolute;
    left: 12px; right: 12px; bottom: 4px;
    height: 3px;
    background: var(--sunset);
    transform: scaleX(0) skewX(-20deg);
    transform-origin: left;
    transition: transform 0.3s var(--ease);
  }
  .hdr__link:hover, .hdr__link.is-active { color: var(--text); }
  .hdr__link:hover::after, .hdr__link.is-active::after { transform: scaleX(1) skewX(-20deg); }
  .hdr__link em {
    font-style: normal; font-size: 0.62rem; padding: 2px 5px; line-height: 1;
    background: var(--teal); color: #041512; letter-spacing: 0.08em;
  }

  .mega {
    position: absolute;
    top: calc(100% + 8px);
    left: -20px;
    width: min(760px, 80vw);
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 20px;
    padding: 18px;
    background: rgba(16, 13, 21, 0.97);
    border: 1px solid var(--line2);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.2s, transform 0.25s var(--ease), visibility 0.2s;
  }
  .has-mega:hover .mega, .has-mega:focus-within .mega { opacity: 1; visibility: visible; transform: none; }
  .mega__games { display: grid; grid-template-columns: repeat(2, 1fr); gap: 8px; }
  .mega__game {
    display: flex; align-items: center; gap: 14px;
    padding: 10px 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--line);
    transition: background 0.2s, border-color 0.2s;
  }
  .mega__game:hover { background: rgba(255, 255, 255, 0.07); border-color: var(--g-from); }
  .mega__num {
    font-size: 1.9rem; min-width: 54px;
    background: linear-gradient(120deg, var(--g-from), var(--g-to));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .mega__name { display: flex; flex-direction: column; font-weight: 600; line-height: 1.2; }
  .mega__name small { color: var(--dim); font-family: var(--f-cond); letter-spacing: 0.1em; }
  .mega__cats { display: flex; flex-direction: column; gap: 2px; border-left: 1px solid var(--line); padding-left: 18px; }
  .mega__cats p { margin: 0 0 6px; font-size: 0.78rem; }
  .mega__cats a { display: flex; align-items: center; gap: 10px; padding: 7px 0; color: var(--muted); font-weight: 500; }
  .mega__cats a:hover { color: var(--text); }

  .hdr__actions { display: flex; align-items: center; gap: 10px; }
  .hdr__search {
    display: flex; align-items: center; gap: 10px;
    height: 40px; padding: 0 10px 0 12px;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--line);
    transition: border-color 0.2s, color 0.2s;
  }
  .hdr__search:hover { color: var(--text); border-color: var(--line2); }
  .hdr__search span { font-size: 0.92rem; min-width: 90px; text-align: left; }
  .hdr__search kbd {
    font-family: var(--f-cond); font-size: 0.75rem; padding: 1px 7px;
    border: 1px solid var(--line2); color: var(--dim);
  }
  .hdr__discord { padding: 0.7em 1.1em; font-size: 0.9rem; }
  .hdr__lang {
    height: 40px; min-width: 40px; padding: 0 10px; display: grid; place-items: center;
    border: 1px solid var(--line); color: var(--muted); font-size: 0.85rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .hdr__lang:hover { color: var(--text); border-color: var(--pink); }
  .hdr__burger { display: none; width: 44px; height: 44px; align-items: center; justify-content: center; }

  @media (max-width: 1320px) {
    .hdr__search span, .hdr__search kbd { display: none; }
    .hdr__search { width: 40px; justify-content: center; padding: 0; }
  }
  @media (max-width: 1180px) {
    .hdr__nav, .hdr__discord { display: none; }
    .hdr__burger { display: inline-flex; }
    .hdr__in { justify-content: space-between; }
  }

  /* Mobile Menü */
  .mmenu {
    position: fixed; inset: 0; z-index: 90;
    background:
      radial-gradient(80vmax 60vmax at 100% 0%, rgba(255, 45, 135, 0.25), transparent 60%),
      radial-gradient(60vmax 60vmax at 0% 100%, rgba(139, 61, 255, 0.25), transparent 60%),
      #07060b;
    display: flex; flex-direction: column;
    overflow-y: auto;
    padding-bottom: 40px;
  }
  .mmenu[hidden] { display: none; }
  .mmenu__top { height: var(--header-h); display: flex; align-items: center; justify-content: space-between; }
  .mmenu__nav { display: flex; flex-direction: column; padding-top: 18px; }
  .mmenu__nav a {
    font-size: clamp(2.6rem, 12vw, 4.2rem);
    line-height: 1.05;
    display: flex; align-items: center; gap: 12px;
    opacity: 0; transform: translateX(-24px);
    animation: mm-in 0.5s var(--ease) forwards;
    animation-delay: calc(var(--i) * 45ms + 60ms);
  }
  .mmenu__nav a:active { color: var(--pink); }
  .mmenu__nav em { font-style: normal; font-size: 0.9rem; background: var(--teal); color: #041512; padding: 3px 7px; }
  @keyframes mm-in { to { opacity: 1; transform: none; } }
  .mmenu__games { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; }
  .mmenu__cta { margin-top: 26px; display: flex; gap: 10px; flex-wrap: wrap; }
</style>
