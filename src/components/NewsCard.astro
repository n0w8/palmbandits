---
import Photo from './Photo.astro';
import Stars from './Stars.astro';
import { getGame } from '../data/games';
import type { News } from '../lib/utils';
import { langFromUrl, useT, href, LOCALE } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = useT(lang);
interface Props { item: News; size?: 'lg' | 'md' | 'row'; delay?: number }
const { item, size = 'md', delay = 0 } = Astro.props;
const d = item.data;
const g = getGame(d.game);
---
<article
  class:list={['card ncard', `ncard--${size}`]}
  data-reveal
  data-filter-item
  data-tags={d.game}
  style={`--d:${delay}s;--g-from:${g.from};--g-to:${g.to}`}
>
  <a href={`${href(lang, '/news/')}${item.id}/`} class="ncard__link">
    <div class="ncard__media">
      <Photo seed={d.translationOf ?? item.id} tags={[d.game]} override={d.image} sizes={size === 'lg' ? '(max-width: 860px) 100vw, 60vw' : size === 'row' ? '200px' : '(max-width: 640px) 100vw, 33vw'} eager={size === 'lg'} />
      <span class="ncard__shade" aria-hidden="true"></span>
      <div class="ncard__badges">
        {d.breaking && <span class="chip chip--live"><span class="dot-live"></span>{t.card.breaking}</span>}
        {d.rumor && <span class="chip chip--rumor">{t.card.rumor}</span>}
      </div>
    </div>
    <div class="ncard__body">
      <div class="ncard__meta">
        <span class="chip chip--game">{g.name}</span>
        <time data-rel datetime={d.pubDate.toISOString()} class="cond">
          {d.pubDate.toLocaleDateString(LOCALE[lang], { day: '2-digit', month: 'short', timeZone: 'Europe/Berlin' })}
        </time>
        <Stars value={d.hype} />
      </div>
      <h3 class="ncard__title">{d.title}</h3>
      {size !== 'row' && <p class="ncard__desc">{d.description}</p>}
    </div>
  </a>
</article>

<style>
  .ncard__link { display: flex; flex-direction: column; height: 100%; }
  .ncard__media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #0b0810; }
  .ncard__media :global(.photo) { transition: transform 0.8s var(--ease), filter 0.4s; filter: saturate(1.05); }
  .ncard:hover .ncard__media :global(.photo) { transform: scale(1.06); filter: saturate(1.25); }
  .ncard__shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 55%, rgba(7, 6, 11, 0.55)), linear-gradient(120deg, color-mix(in srgb, var(--g-from) 22%, transparent), transparent 45%); pointer-events: none; }
  .ncard__badges { position: absolute; top: 12px; left: 12px; display: flex; gap: 6px; }
  .ncard__body { padding: 16px 18px 22px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
  .ncard__meta { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .ncard__meta time { color: var(--muted); font-size: 0.82rem; }
  .ncard__title {
    font-family: var(--f-cond);
    font-weight: 700;
    font-size: 1.35rem;
    line-height: 1.15;
    letter-spacing: 0.005em;
    transition: color 0.2s;
  }
  .ncard:hover .ncard__title { color: #fff; }
  .ncard__desc { margin: 0; color: var(--muted); font-size: 0.96rem; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }

  .ncard--lg .ncard__title { font-family: var(--f-display); font-weight: 400; text-transform: uppercase; font-size: clamp(1.8rem, 3.6vw, 3rem); line-height: 1; }
  .ncard--lg .ncard__desc { font-size: 1.05rem; }
  .ncard--lg .ncard__media { aspect-ratio: 16 / 8; }

  .ncard--row .ncard__link { flex-direction: row; align-items: stretch; }
  .ncard--row .ncard__media { width: 38%; flex: none; aspect-ratio: auto; min-height: 110px; }
  .ncard--row .ncard__body { padding: 12px 16px; justify-content: center; }
  .ncard--row .ncard__title { font-size: 1.12rem; }
  .ncard--row .ncard__badges { top: 8px; left: 8px; }
</style>
