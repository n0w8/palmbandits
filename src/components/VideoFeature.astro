---
// Video-Block der Startseite (Mike 18.11.2026: "bau das video auf der hauptseite direkt ein und präsentiere es gut").
// Erscheint nur, wenn VIDEO.youtubeId in src/config.ts gesetzt ist.
// Vor dem Klick: nur das eigene Vorschaubild vom eigenen Webspace, kein Kontakt zu Google.
// Nach dem Klick: youtube-nocookie mit Autoplay. Dazu VideoObject als JSON-LD (für die Google-Videosuche).
import { VIDEO, SITE } from '../config';
import { langFromUrl, href } from '../i18n';
import { MERCH_ITEMS, merchImage, merchPrice, merchRoute } from '../data/merch';
import Icon from './Icon.astro';

const lang = langFromUrl(Astro.url);
// Mike 22.11.2026: "zum gta video genau dieses merch anbieten unter dem video".
// Die Crew aus dem Video in der Reihenfolge der Chips, je das Shirt (id "<name>-tee" in src/data/merch.ts).
// Wer (noch) kein Produkt hat, fehlt einfach (z. B. Domsgard, solange der Hase nicht freigegeben ist).
const crewMerch = VIDEO.cast
  .map((c) => MERCH_ITEMS.find((m) => m.id === `${c.name.toLowerCase()}-tee` && !m.soon))
  .filter((m): m is (typeof MERCH_ITEMS)[number] => Boolean(m));
const shop = href(lang, '/shop/');
const id = VIDEO.youtubeId.trim();
const watch = `https://www.youtube.com/watch?v=${id}`;
const L = {
  de: {
    play: 'Musikvideo abspielen', watch: 'Auf YouTube ansehen', sub: 'Kanal abonnieren', shop: 'Merch der Crew',
    cast: 'Die Crew im Video', note: 'Mit dem Klick lädt YouTube (Google), dabei wird deine IP-Adresse übertragen.', more: 'Datenschutz',
    now: 'Jetzt neu', site: 'Website öffnen (neuer Tab)',
    merch: 'Das Merch aus dem Video', merchText: 'Die Crew als Shirt und Hoodie, hinten PALM BANDITS am Kragen.', allMerch: 'Alle Designs', buy: 'kaufen',
  },
  en: {
    play: 'Play the music video', watch: 'Watch on YouTube', sub: 'Subscribe to the channel', shop: 'Crew merch',
    cast: 'The crew in the video', note: 'Clicking loads YouTube (Google), which receives your IP address.', more: 'Privacy',
    now: 'Out now', site: 'open website (new tab)',
    merch: 'Merch from the video', merchText: 'The crew on tees and hoodies, PALM BANDITS on the back below the collar.', allMerch: 'All designs', buy: 'buy',
  },
}[lang];
const jsonLd = id ? {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${VIDEO.artist} - ${VIDEO.song} (Official Music Video)`,
  description: VIDEO.text[lang],
  thumbnailUrl: [`${SITE.url}${VIDEO.poster}`],
  uploadDate: VIDEO.uploadDate,
  duration: VIDEO.durationIso,
  embedUrl: `https://www.youtube-nocookie.com/embed/${id}`,
  contentUrl: watch,
  inLanguage: lang,
} : null;
---
{id && (
  <section class="section wrap vf" aria-labelledby="sec-video">
    <div class="vf__grid">
      <div class="vf__frame" data-video={id}>
        <button type="button" class="vf__play" data-video-play aria-label={`${L.play}: ${VIDEO.title[lang]}`}>
          <img class="vf__poster" src={VIDEO.poster} srcset={`${VIDEO.posterSmall} 640w, ${VIDEO.poster} 1280w`}
            sizes="(max-width: 960px) 92vw, 760px" width="1280" height="720" alt={`${VIDEO.title[lang]}, ${lang === 'en' ? 'video thumbnail' : 'Vorschaubild'}`} loading="eager" decoding="async" />
          <span class="vf__shade" aria-hidden="true"></span>
          <span class="vf__btn" aria-hidden="true"><Icon name="play" size={38} /></span>
          <span class="vf__dur cond" aria-hidden="true">{VIDEO.duration}</span>
          <span class="vf__badge chip chip--live" aria-hidden="true">{L.now}</span>
        </button>
      </div>

      <div class="vf__info">
        <p class="sec-head__kicker cond"><b>Video</b> / {VIDEO.kicker[lang]}</p>
        <h2 id="sec-video" class="vf__title display">
          <span class="vf__artist">{VIDEO.artist}</span>
          <span class="grad-text">{VIDEO.song}</span>
        </h2>
        <p class="vf__text">{VIDEO.text[lang]}</p>
        <p class="vf__castk cond">{L.cast}</p>
        <ul class="vf__cast">{VIDEO.cast.map((c) => (
          <li class="cond">{c.url
            ? <a href={c.url} target="_blank" rel="noopener" aria-label={`${c.name}: ${L.site}`}>{c.name}<Icon name="arrow" size={12} /></a>
            : <span>{c.name}</span>}</li>
        ))}</ul>
        <div class="vf__btns">
          <button type="button" class="btn btn--sun" data-video-start><Icon name="play" /> {L.play}</button>
          <a class="btn btn--ghost" href={watch} target="_blank" rel="noopener">{L.watch} <Icon name="arrow" /></a>
        </div>
        <p class="vf__links">
          <a href={VIDEO.channel} target="_blank" rel="noopener">{L.sub}</a>
          <span aria-hidden="true">·</span>
          <a href={`${href(lang, '/shop/')}#produkte`}>{L.shop}</a>
        </p>
        <p class="vf__note">{L.note} <a href="/datenschutz/">{L.more}</a></p>
      </div>
    </div>
    {crewMerch.length > 0 && (
      <div class="vf__merch" id="video-merch">
        <div class="vf__merch-head">
          <div>
            <p class="sec-head__kicker cond"><b>Merch</b> / {L.merch}</p>
            <p class="vf__merch-text">{L.merchText}</p>
          </div>
          <a class="vf__merch-all cond" href={`${shop}#produkte`}>{L.allMerch} <Icon name="arrow" size={14} /></a>
        </div>
        <ul class="vf__merch-row">
          {crewMerch.map((m) => (
            <li>
              <a class="vf__mcard" href={`${shop}${merchRoute(m)}`} data-astro-reload data-merch-buy aria-label={`${m.name[lang]} ${L.buy}`}>
                <span class="vf__mimg">
                  <img src={merchImage(m, 400)} srcset={`${merchImage(m, 300)} 300w, ${merchImage(m, 400)} 400w`} sizes="180px"
                    alt={`${m.name[lang]}, ${m.type[lang]}`} width="400" height="400" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
                </span>
                <span class="vf__mname cond">{m.name[lang]}</span>
                <span class="vf__mprice">{merchPrice(m.price, lang)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </section>
)}

<style>
  .vf__grid { display: grid; grid-template-columns: minmax(0, 1.65fr) minmax(0, 1fr); gap: clamp(20px, 3vw, 40px); align-items: center; }
  .vf__frame {
    position: relative; aspect-ratio: 16 / 9; overflow: hidden; border-radius: 6px; background: #000;
    box-shadow: 0 0 0 1px var(--line2), 0 30px 80px -20px rgba(255, 42, 140, 0.45), 0 20px 60px -30px rgba(0, 200, 255, 0.35);
  }
  .vf__frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .vf__play { position: absolute; inset: 0; width: 100%; padding: 0; border: 0; background: none; cursor: pointer; color: #fff; }
  .vf__poster { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease, filter 0.3s ease; }
  .vf__shade { position: absolute; inset: 0; background: radial-gradient(circle at 50% 50%, rgba(0, 0, 0, 0.05), rgba(0, 0, 0, 0.45) 75%); }
  .vf__btn {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    display: grid; place-items: center; width: 96px; height: 96px; border-radius: 50%;
    background: linear-gradient(135deg, #ffb31f, #ff2a8c 55%, #8b3dff); box-shadow: 0 10px 40px rgba(255, 42, 140, 0.6);
    transition: transform 0.2s ease;
  }
  .vf__btn::after { content: ''; position: absolute; inset: -10px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.55); animation: vf-pulse 2.2s ease-out infinite; }
  @keyframes vf-pulse { from { transform: scale(0.9); opacity: 0.9; } to { transform: scale(1.35); opacity: 0; } }
  .vf__play:hover .vf__poster, .vf__play:focus-visible .vf__poster { transform: scale(1.03); filter: saturate(1.15); }
  .vf__play:hover .vf__btn, .vf__play:focus-visible .vf__btn { transform: translate(-50%, -50%) scale(1.08); }
  .vf__dur { position: absolute; right: 12px; bottom: 12px; padding: 3px 9px; border-radius: 4px; background: rgba(0, 0, 0, 0.75); font-size: 0.85rem; letter-spacing: 0.04em; }
  .vf__badge { position: absolute; left: 14px; top: 14px; }
  .vf__title { margin: 6px 0 14px; line-height: 0.95; display: flex; flex-direction: column; gap: 4px; }
  .vf__artist { font-size: clamp(1.2rem, 2vw, 1.6rem); letter-spacing: 0.08em; color: var(--muted); }
  .vf__title .grad-text { font-size: clamp(2.2rem, 4.6vw, 3.6rem); }
  .vf__text { margin: 0 0 18px; color: var(--text); opacity: 0.85; max-width: 52ch; }
  .vf__castk { margin: 0 0 8px; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .vf__cast { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0 0 22px; padding: 0; }
  .vf__cast li { font-size: 0.85rem; letter-spacing: 0.04em; }
  .vf__cast li > span, .vf__cast li > a { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border: 1px solid var(--line2); border-radius: 999px; }
  .vf__cast li > a { color: var(--text); transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease; }
  .vf__cast li > a :global(svg) { opacity: 0.55; transition: transform 0.2s ease, opacity 0.2s ease; }
  .vf__cast li > a:hover, .vf__cast li > a:focus-visible { border-color: var(--pink); color: var(--pink); background: rgba(255, 42, 140, 0.08); }
  .vf__cast li > a:hover :global(svg), .vf__cast li > a:focus-visible :global(svg) { opacity: 1; transform: translateX(2px); }
  .vf__btns { display: flex; flex-wrap: wrap; gap: 10px; }
  .vf__links { margin: 14px 0 0; font-size: 0.9rem; display: flex; gap: 8px; flex-wrap: wrap; }
  .vf__links a { text-decoration: underline; text-underline-offset: 3px; }
  .vf__links a:hover { color: var(--pink); }
  .vf__note { margin: 12px 0 0; font-size: 0.78rem; opacity: 0.6; }
  .vf__note a { text-decoration: underline; }
  .vf__merch { margin-top: clamp(22px, 3vw, 36px); padding-top: 22px; border-top: 1px solid var(--line); }
  .vf__merch-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 14px; }
  .vf__merch-head .sec-head__kicker { margin: 0; }
  .vf__merch-text { margin: 4px 0 0; font-size: 0.9rem; color: var(--muted); }
  .vf__merch-all { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; font-size: 0.9rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .vf__merch-all:hover { color: var(--pink); }
  .vf__merch-row { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(150px, 1fr); gap: 12px; list-style: none; margin: 0; padding: 0 0 6px; overflow-x: auto; scroll-snap-type: x mandatory; }
  .vf__merch-row li { scroll-snap-align: start; }
  .vf__mcard { display: flex; flex-direction: column; gap: 4px; padding: 0 0 10px; border: 1px solid var(--line); border-radius: 6px; overflow: hidden; background: var(--panel); transition: border-color 0.2s ease, transform 0.2s ease; }
  .vf__mcard:hover, .vf__mcard:focus-visible { border-color: var(--pink); transform: translateY(-2px); }
  .vf__mimg { display: block; aspect-ratio: 1; background: radial-gradient(circle at 50% 35%, rgba(255, 138, 31, 0.2), rgba(139, 61, 255, 0.1) 55%, transparent 75%); }
  .vf__mimg img { width: 100%; height: 100%; object-fit: contain; }
  .vf__mname { padding: 0 10px; font-size: 0.95rem; letter-spacing: 0.04em; }
  .vf__mprice { padding: 0 10px; font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 960px) {
    .vf__merch-row { grid-auto-columns: 150px; }
    .vf__grid { grid-template-columns: 1fr; }
    .vf__btn { width: 76px; height: 76px; }
  }
</style>

<script>
  function start(box: HTMLElement) {
    if (box.querySelector('iframe')) return;
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(box.dataset.video ?? '')}?autoplay=1&rel=0&playsinline=1`;
    f.title = 'YouTube';
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    f.allowFullscreen = true;
    f.referrerPolicy = 'strict-origin-when-cross-origin';
    box.replaceChildren(f);
  }
  function init() {
    const box = document.querySelector<HTMLElement>('[data-video]');
    if (!box) return;
    box.querySelector('[data-video-play]')?.addEventListener('click', () => start(box));
    document.querySelector('[data-video-start]')?.addEventListener('click', () => {
      start(box);
      box.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
  document.addEventListener('astro:page-load', init);
</script>
