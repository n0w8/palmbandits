---
// Produktvitrine im Look der Seite (wie auf eldruna.com): Bild, Name, Preis, "Kaufen" öffnet den
// eingebetteten Spreadshop auf /shop/ direkt beim Produkt. Bilder kommen vom Spreadshirt-Bildserver
// (in der Datenschutzerklärung unter "Produktbilder" beschrieben).
import Icon from './Icon.astro';
import { MERCH_ITEMS, merchImage, merchPrice, merchRoute } from '../data/merch';
import { href, langFromUrl } from '../i18n';

interface Props { limit?: number; onShopPage?: boolean }
const { limit, onShopPage = false } = Astro.props;
const lang = langFromUrl(Astro.url);
const en = lang === 'en';
const items = limit ? MERCH_ITEMS.slice(0, limit) : MERCH_ITEMS;
const shop = href(lang, '/shop/');
const L = en
  ? { buy: 'Buy', isNew: 'New', note: 'Printed and shipped by Spreadshirt. Sizes and checkout open right here.' }
  : { buy: 'Kaufen', isNew: 'Neu', note: 'Gedruckt und versendet von Spreadshirt. Größen und Kasse öffnen sich direkt hier.' };
---
<div class="mgrid">
  {items.map((m, i) => (
    <article class="mcard card" data-reveal style={`--d:${(i % 3) * 0.06}s`}>
      <a class="mcard__img" href={`${shop}${merchRoute(m)}`} data-astro-reload={!onShopPage || undefined} data-merch-buy aria-label={`${m.name[lang]} ${L.buy}`}>
        {m.isNew && <span class="chip chip--live mcard__chip">{L.isNew}</span>}
        <img src={merchImage(m, 600)} srcset={`${merchImage(m, 400)} 400w, ${merchImage(m, 600)} 600w, ${merchImage(m, 900)} 900w`}
          sizes="(max-width: 640px) 90vw, (max-width: 1100px) 45vw, 360px" alt={`${m.name[lang]}, ${m.type[lang]}`}
          width="600" height="600" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
      </a>
      <div class="mcard__body">
        <p class="mcard__type cond">{m.type[lang]}</p>
        <h3 class="mcard__name display">{m.name[lang]}</h3>
        <div class="mcard__row">
          <span class="mcard__price display">{merchPrice(m.price, lang)}</span>
          <a class="btn btn--sun" href={`${shop}${merchRoute(m)}`} data-astro-reload={!onShopPage || undefined} data-merch-buy><Icon name="cart" /> {L.buy}</a>
        </div>
      </div>
    </article>
  ))}
</div>
<p class="mgrid__note muted">{L.note}</p>

<style>
  .mgrid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
  .mcard { display: flex; flex-direction: column; overflow: hidden; padding: 0; }
  .mcard__img { position: relative; display: block; aspect-ratio: 1; background: radial-gradient(circle at 50% 35%, rgba(255, 138, 31, 0.22), rgba(139, 61, 255, 0.10) 55%, transparent 75%), var(--panel); }
  .mcard__img img { width: 100%; height: 100%; object-fit: contain; transition: transform 0.4s ease; }
  .mcard:hover .mcard__img img { transform: scale(1.04); }
  .mcard__chip { position: absolute; top: 14px; left: 14px; z-index: 1; }
  .mcard__body { display: flex; flex-direction: column; gap: 6px; padding: 16px 18px 18px; border-top: 1px solid var(--line); }
  .mcard__type { margin: 0; color: var(--muted); font-size: 0.8rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .mcard__name { margin: 0; font-size: 1.35rem; line-height: 1.1; }
  .mcard__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 8px; }
  .mcard__price { font-size: 1.5rem; }
  .mgrid__note { margin-top: 12px; font-size: 0.85rem; }
  @media (max-width: 1100px) { .mgrid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .mgrid { grid-template-columns: 1fr; } }
</style>
