---
import Page from '../../../guides/kategorie/[category].astro';
import { CATEGORIES } from '../../../../data/categories';
import { CAT_EN } from '../../../../i18n';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: CAT_EN[c.slug] ?? c.slug }, props: { key: c.slug } }));
}
---
<Page {...Astro.props} />
