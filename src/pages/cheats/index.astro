---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { getCheatFiles } from '../../lib/utils';
import { GAMES, getGame } from '../../data/games';
import { langFromUrl, useT, href } from '../../i18n';

const lang = langFromUrl(Astro.url);
const t = useT(lang);
const h = (p: string) => href(lang, p);
const en = lang === 'en';

const files = getCheatFiles().sort((a, b) => GAMES.findIndex((g) => g.slug === a.game) - GAMES.findIndex((g) => g.slug === b.game));
const total = files.reduce((s, f) => s + f.cheats.length, 0);
const g6 = getGame('gta-6');
const PLAT: Record<string, string> = { pc: 'PC', phone: en ? 'Phone' : 'Handy', playstation: 'PlayStation', xbox: 'Xbox' };
const L = en
  ? { title: 'GTA Cheats: Every Code for GTA 5, San Andreas, Vice City, IV & III', desc: `Every GTA cheat in one place: ${total} codes for GTA 5, San Andreas, Vice City, GTA 4 and GTA 3. PC codes, phone numbers and console combos with a copy button.`,
      lead: `${total} cheats for every game. Tap a code, copy it, paste it. Note: cheats never work in GTA Online.`, isNew: 'New',
      six: 'Are there cheats in GTA 6? We add every confirmed code as soon as it is known.', all: 'All codes' }
  : { title: 'GTA Cheats: alle Codes für GTA 5, San Andreas, Vice City, IV & III', desc: `Alle GTA Cheats auf Deutsch: ${total} Codes für GTA 5, San Andreas, Vice City, GTA 4 und GTA 3. PC-Codes, Handynummern und Konsolen-Kombos mit Kopier-Button.`,
      lead: `${total} Cheats für alle Teile. Code antippen, kopieren, einfügen. Hinweis: Cheats funktionieren nie in GTA Online.`, isNew: 'Neu',
      six: 'Gibt es Cheats in GTA 6? Wir tragen jeden bestätigten Code ein, sobald er bekannt ist.', all: 'Alle Codes' };
---
<Base title={L.title} description={L.desc}>
  <section class="page-hero wrap">
    <span class="page-hero__bg" aria-hidden="true">CODE</span>
    <nav class="crumbs" aria-label={t.nav.crumbs}><a href={h('/')}>{t.article.home}</a><span aria-hidden="true">/</span><span>Cheats</span></nav>
    <h1 class="page-hero__title display">GTA <span class="grad-text">Cheats</span></h1>
    <p class="page-hero__lead">{L.lead}</p>
  </section>

  <section class="wrap cgrid">
    <a href={h('/cheats/gta-6/')} class="card cg" data-reveal data-tilt style={`--g-from:${g6.from};--g-to:${g6.to}`}>
      <span class="cg__num display" aria-hidden="true">VI</span>
      <span class="chip chip--live"><span class="dot-live"></span>{L.isNew}</span>
      <b class="display">GTA 6 Cheats</b>
      <span class="muted">{L.six}</span>
    </a>
    {files.map((f, i) => {
      const g = getGame(f.game);
      return (
        <a href={h(`/cheats/${f.game}/`)} class="card cg" data-reveal data-tilt style={`--g-from:${g.from};--g-to:${g.to};--d:${(i % 3) * 0.05}s`}>
          <span class="cg__num display" aria-hidden="true">{g.numeral}</span>
          <span class="chip chip--game">{f.cheats.length} Cheats</span>
          <b class="display">{g.name} Cheats</b>
          <span class="muted">{Object.keys(f.howTo).map((k) => PLAT[k]).join(' · ')}</span>
          <span class="cg__go cond">{L.all} <Icon name="arrow" size={16} /></span>
        </a>
      );
    })}
  </section>
</Base>

<style>
  .cgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .cg { display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 26px; min-height: 240px; overflow: hidden; transition: transform 0.25s ease-out, border-color 0.3s; }
  .cg b { font-weight: 400; font-size: 2.2rem; margin-top: auto; }
  .cg__num { position: absolute; right: -0.05em; top: -0.12em; font-size: 9rem; line-height: 1; z-index: -1; color: transparent; -webkit-text-stroke: 2px color-mix(in srgb, var(--g-from) 50%, transparent); }
  .cg__go { display: inline-flex; align-items: center; gap: 6px; color: var(--g-from); font-size: 0.85rem; }
  @media (max-width: 1000px) { .cgrid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .cgrid { grid-template-columns: 1fr; } .cg { min-height: 0; } }
</style>
