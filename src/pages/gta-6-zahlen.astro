---
// Zahlen-Hub "GTA 6 in Zahlen". Deutsch: /gta-6-zahlen/, Englisch: /en/gta-6-stats/ (importiert diese Datei).
// Alle Zahlen, Quellen und Stand-Daten stehen in src/data/gta6-stats.ts. Hier nur Aufbau und Seitentexte.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import StatTable from '../components/StatTable.astro';
import { getImage } from 'astro:assets';
import ogPhoto from '../assets/pool/23-launch-night.jpg';
import { SITE, GTA6_RELEASE, discordFor } from '../config';
import { langFromUrl, useT, href, LOCALE } from '../i18n';
import {
  SOURCES, STATUS_LABEL, KPIS, SALES, FORECASTS, COMPARE, SERIES, RELEASE, TRAILERS, VIEWS_AS_OF, DEV, WORLD,
  REVIEWS, TIMELINE, FAQ, CHANGELOG, NEXT_UP, UPDATED, PUBLISHED, GTA5_RELEASE, GTA6_RELEASE_DAY, fmtDay,
  type Status, type SrcId, type Stat,
} from '../data/gta6-stats';

const lang = langFromUrl(Astro.url);
const t = useT(lang);
const h = (p: string) => href(lang, p);
const en = lang === 'en';
const loc = LOCALE[lang];

// Datum mit Uhrzeit (deutsche Zeit)
const fmtTime = (iso: string) => {
  const s = new Intl.DateTimeFormat(loc, { day: en ? 'numeric' : '2-digit', month: en ? 'short' : '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin' }).format(new Date(iso));
  return en ? `${s} CET` : `${s} Uhr`;
};
const fmtN = (n: number) => new Intl.NumberFormat(loc).format(n);
const fmtM = (n: number) => `${new Intl.NumberFormat(loc, { maximumFractionDigits: 1 }).format(n / 1e6)} ${en ? 'M' : 'Mio.'}`;

// Abstand GTA V bis GTA VI (berechnet)
const waitDays = Math.round((Date.parse(GTA6_RELEASE_DAY) - Date.parse(GTA5_RELEASE)) / 864e5);
const waitRow: Stat = {
  label: { de: 'Abstand zu GTA V', en: 'Gap since GTA V' },
  value: { de: `13 Jahre und 2 Monate (${fmtN(waitDays)} Tage)`, en: `13 years and 2 months (${fmtN(waitDays)} days)` },
  note: { de: 'Von uns berechnet: 17.09.2013 bis 19.11.2026', en: 'Calculated by us: 17 Sep 2013 to 19 Nov 2026' },
  status: 'own', asOf: '2026-11-18', src: ['gamespot1b', 'tt8k'],
};
const devRows = [...DEV, waitRow];

// Trailer-Aufrufe heute (YouTube, eigener Abruf)
const trailersByViews = [...TRAILERS].sort((a, b) => b.views - a.views);
const maxViews = trailersByViews[0].views;
const totalViews = TRAILERS.reduce((s, x) => s + x.views, 0);

// Zeitstrahl: was nach dem Build liegt, ist "demnächst"
const buildDay = new Date().toISOString().slice(0, 10);

// Quellen: neueste zuerst
const sourceList = (Object.entries(SOURCES) as [SrcId, (typeof SOURCES)[SrcId]][])
  .sort((a, b) => b[1].date.localeCompare(a[1].date));

const STATUSES: Status[] = ['confirmed', 'reported', 'estimate', 'pending', 'own'];

const L = en
  ? {
      title: 'GTA 6 Stats: Sales, Pre-Orders, Records & Key Numbers',
      desc: 'GTA 6 by the numbers, with sources: pre-order records, GTA 5 at nearly 235M sold, 475M trailer views, 212 GB, prices and launch times. Updated continuously.',
      crumb: 'By the numbers', h1a: 'GTA 6 by the', h1b: 'numbers',
      lead: 'Sales, pre-orders, trailer records, prices, launch times and everything else you can count. Every number with source and date, estimates clearly labeled.',
      live: 'Live', updating: 'Updated continuously', asOf: 'As of', cdLabel: 'Countdown to midnight CET', units: ['Days', 'Hrs', 'Min', 'Sec'], cdOut: 'GTA VI is out',
      legend: 'What the labels mean', jump: 'Jump to',
      nav: ['Key numbers', 'Sales', 'Forecasts', 'GTA V vs. VI', 'Release & tech', 'Trailers', 'Development', 'World', 'Reviews', 'Timeline', 'FAQ', 'Sources'],
      kpiK: 'At a glance', kpiH: ['The big', 'numbers'],
      salesK: 'Sales & pre-orders', salesH: ['How many', 'sold?'],
      salesLead: 'Short answer: there are no official GTA VI sales figures yet. What is confirmed are the pre-order records on PlayStation and Xbox. Everything with an exact unit count comes from market research and is an estimate.',
      foreK: 'Forecasts', foreH: ['What analysts', 'expect'],
      foreLead: 'Forecasts for launch day, week one and the first months. None of these numbers is official, they show the range of expectations.',
      cmpK: 'Comparison', cmpH: ['GTA V vs.', 'GTA VI'], cmpLead: 'GTA V set records in 2013 that still stand today. This is how the numbers compare so far.',
      cmpMetric: 'Metric', gap: 'days between GTA V and GTA VI', seriesH: 'Rockstar series to date',
      relK: 'Release, prices & tech', relH: ['Times, prices', 'and gigabytes'],
      relLead: 'When it unlocks, what it costs, how much space you need.',
      trK: 'Trailers & reach', trH: ['Record', 'trailers'],
      trLead: 'GTA VI broke viewing records long before release. First the records from the first days, then today\'s YouTube count.',
      trDate: 'Released', trToday: 'YouTube today', barsH: 'YouTube views today', barsTotal: 'Total for these four videos',
      barsNote: (d: string) => `Own count: views on the Rockstar Games YouTube channel, read on ${d}. Netflix views and re-uploads are not included.`,
      devK: 'Development, team & budget', devH: ['How long it', 'took'], devLead: 'The budget has never been officially disclosed. Every budget figure is an estimate.',
      worldK: 'The world', worldH: ['Leonida in', 'numbers'], worldLead: 'Only what Rockstar has said officially. Map sizes in square kilometres you see elsewhere come from leaks or fan measurements.',
      revK: 'Reviews', revH: ['Metascore', 'watch'], revLead: 'We add the Metascore as soon as Metacritic shows one. For comparison: the best-rated Rockstar games.',
      tlK: 'Timeline', tlH: ['From reveal to', 'release'], soon: 'Coming', today: 'Today',
      updK: 'Updated continuously', updH: ['What changed', 'last'], updAsOf: 'Last update', updNext: 'Coming next', updLog: 'Change log',
      updText: 'We update this page as soon as new official numbers arrive. Found a mistake or a better source? Tell us on Discord.',
      discord: 'Report on Discord', news: 'All GTA 6 news',
      faqK: 'FAQ', faqH: ['Quick', 'answers'],
      srcK: 'Sources', srcH: ['All', 'sources'], srcLead: (n: number) => `${n} sources, newest first. The date is the publication date or, for YouTube and Metacritic, the date we checked.`,
      disclaimer: 'Unofficial fan project, not affiliated with Rockstar Games or Take-Two Interactive. Estimates from analysts and market research are not official sales figures.',
      gameLabel: 'GTA 6',
    }
  : {
      title: 'GTA 6 in Zahlen: Verkäufe, Vorbestellungen, Rekorde & Fakten',
      desc: 'GTA 6 Statistik mit Quellen: Vorbestell-Rekord, GTA 5 mit fast 235 Mio. Verkäufen, 475 Mio. Trailer-Aufrufe, 212 GB, Preise und Release-Uhrzeit. Laufend aktualisiert.',
      crumb: 'In Zahlen', h1a: 'GTA 6 in', h1b: 'Zahlen',
      lead: 'Verkäufe, Vorbestellungen, Trailer-Rekorde, Preise, Uhrzeiten und alles, was sich zählen lässt. Jede Zahl mit Quelle und Stand, Schätzungen klar markiert.',
      live: 'Live', updating: 'Wird laufend aktualisiert', asOf: 'Stand', cdLabel: 'Release in Deutschland in', units: ['Tage', 'Std', 'Min', 'Sek'], cdOut: 'GTA VI ist da',
      legend: 'Was die Marken bedeuten', jump: 'Springe zu',
      nav: ['Auf einen Blick', 'Verkäufe', 'Prognosen', 'GTA V vs. VI', 'Release & Technik', 'Trailer', 'Entwicklung', 'Spielwelt', 'Wertungen', 'Zeitstrahl', 'FAQ', 'Quellen'],
      kpiK: 'Auf einen Blick', kpiH: ['Die großen', 'Zahlen'],
      salesK: 'Verkäufe & Vorbestellungen', salesH: ['Wie oft', 'verkauft?'],
      salesLead: 'Kurz gesagt: Offizielle Verkaufszahlen zu GTA VI gibt es noch nicht. Bestätigt sind die Vorbestell-Rekorde bei PlayStation und Xbox. Alles mit genauer Stückzahl stammt von Marktforschern und ist eine Schätzung.',
      foreK: 'Prognosen', foreH: ['Was Analysten', 'erwarten'],
      foreLead: 'Vorhersagen für Launch-Tag, erste Woche und die ersten Monate. Keine dieser Zahlen ist offiziell, sie zeigen die Spanne der Erwartungen.',
      cmpK: 'Vergleich', cmpH: ['GTA V gegen', 'GTA VI'], cmpLead: 'GTA V hat 2013 Rekorde aufgestellt, die bis heute stehen. So sehen die Zahlen im Vergleich bisher aus.',
      cmpMetric: 'Kennzahl', gap: 'Tage zwischen GTA V und GTA VI', seriesH: 'Rockstar-Reihen bisher',
      relK: 'Release, Preise & Technik', relH: ['Uhrzeit, Preise', 'und Gigabyte'],
      relLead: 'Wann es losgeht, was es kostet, wie viel Platz du brauchst.',
      trK: 'Trailer & Reichweite', trH: ['Rekord-', 'Trailer'],
      trLead: 'GTA VI hat lange vor dem Release Aufruf-Rekorde gebrochen. Erst die Rekorde aus den ersten Tagen, dann der Stand auf YouTube heute.',
      trDate: 'Erschienen', trToday: 'YouTube heute', barsH: 'YouTube-Aufrufe heute', barsTotal: 'Zusammen für diese vier Videos',
      barsNote: (d: string) => `Eigene Messung: Aufrufe auf dem YouTube-Kanal von Rockstar Games, abgelesen am ${d}. Netflix-Aufrufe und Re-Uploads sind nicht enthalten.`,
      devK: 'Entwicklung, Team & Budget', devH: ['So lange hat', 'es gedauert'], devLead: 'Das Budget ist nie offiziell genannt worden. Jede Budget-Zahl ist eine Schätzung.',
      worldK: 'Spielwelt', worldH: ['Leonida in', 'Zahlen'], worldLead: 'Nur was Rockstar offiziell gesagt hat. Kartengrößen in Quadratkilometern, die du anderswo liest, stammen aus Leaks oder Fan-Messungen.',
      revK: 'Wertungen', revH: ['Metascore-', 'Check'], revLead: 'Den Metascore tragen wir ein, sobald Metacritic einen zeigt. Zum Vergleich: die bestbewerteten Rockstar-Spiele.',
      tlK: 'Zeitstrahl', tlH: ['Von der Ankündigung', 'bis zum Release'], soon: 'Demnächst', today: 'Heute',
      updK: 'Wird laufend aktualisiert', updH: ['Was zuletzt', 'dazukam'], updAsOf: 'Letztes Update', updNext: 'Als Nächstes', updLog: 'Änderungen',
      updText: 'Wir aktualisieren diese Seite, sobald neue offizielle Zahlen kommen. Fehler entdeckt oder bessere Quelle? Sag es uns im Discord.',
      discord: 'Im Discord melden', news: 'Alle GTA 6 News',
      faqK: 'Häufige Fragen', faqH: ['Kurz', 'beantwortet'],
      srcK: 'Quellen', srcH: ['Alle', 'Quellen'], srcLead: (n: number) => `${n} Quellen, neueste zuerst. Das Datum ist die Veröffentlichung oder bei YouTube und Metacritic der Tag unseres Abrufs.`,
      disclaimer: 'Inoffizielles Fan-Projekt, nicht verbunden mit Rockstar Games oder Take-Two Interactive. Schätzungen von Analysten und Marktforschern sind keine offiziellen Verkaufszahlen.',
      gameLabel: 'GTA 6',
    };

const IDS = ['blick', 'verkaeufe', 'prognosen', 'vergleich', 'release', 'trailer', 'entwicklung', 'spielwelt', 'wertungen', 'zeitstrahl', 'faq', 'quellen'];

// Vorschaubild 1200x675 (eigenes KI-Foto aus dem Pool, kein Rockstar-Artwork)
const og = await getImage({ src: ogPhoto, width: 1200, height: 675, format: 'jpg', quality: 82, fit: 'cover' });
const url = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: L.title,
    description: L.desc,
    datePublished: new Date(PUBLISHED).toISOString(),
    dateModified: new Date(UPDATED).toISOString(),
    inLanguage: loc,
    mainEntityOfPage: url,
    image: [new URL(og.src, SITE.url).toString()],
    author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` } },
    about: {
      '@type': 'VideoGame', name: 'Grand Theft Auto VI', datePublished: GTA6_RELEASE_DAY,
      gamePlatform: ['PlayStation 5', 'Xbox Series X', 'Xbox Series S'], publisher: { '@type': 'Organization', name: 'Rockstar Games' },
    },
    citation: Object.values(SOURCES).map((s) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.article.home, item: `${SITE.url}${h('/')}` },
      { '@type': 'ListItem', position: 2, name: L.gameLabel, item: `${SITE.url}${h('/spiele/gta-6/')}` },
      { '@type': 'ListItem', position: 3, name: L.title, item: url },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q[lang], acceptedAnswer: { '@type': 'Answer', text: f.a[lang] } })),
  },
];
---
<Base title={L.title} description={L.desc} image={og.src} type="article" published={new Date(PUBLISHED)} modified={new Date(UPDATED)} jsonLd={jsonLd}>
  <section class="page-hero wrap">
    <span class="page-hero__bg" aria-hidden="true">VI</span>
    <nav class="crumbs" aria-label={t.nav.crumbs}>
      <a href={h('/')}>{t.article.home}</a><span aria-hidden="true">/</span>
      <a href={h('/spiele/gta-6/')}>{L.gameLabel}</a><span aria-hidden="true">/</span><span>{L.crumb}</span>
    </nav>
    <p class="hero-k cond intro">
      <span class="chip chip--live"><span class="dot-live"></span>{L.live}</span>
      <span>{L.updating}</span>
      <span class="hero-k__asof">{L.asOf}: <time datetime={UPDATED}>{fmtTime(UPDATED)}</time></span>
    </p>
    <h1 class="page-hero__title display intro" style="--d:.06s">{L.h1a} <span class="grad-text">{L.h1b}</span></h1>
    <p class="page-hero__lead intro" style="--d:.12s">{L.lead}</p>

    <div class="hero-row intro" style="--d:.18s">
      <a href={h('/spiele/gta-6/')} class="cdm" data-countdown={GTA6_RELEASE}>
        <span class="cdm__label cond"><span class="dot-live"></span> {L.cdLabel}</span>
        <span class="cdm__grid">
          <span><b data-cd="d">--</b><small>{L.units[0]}</small></span>
          <span><b data-cd="h">--</b><small>{L.units[1]}</small></span>
          <span><b data-cd="m">--</b><small>{L.units[2]}</small></span>
          <span><b data-cd="s">--</b><small>{L.units[3]}</small></span>
        </span>
        <span class="cdm__live display">{L.cdOut}</span>
      </a>
      <div class="legend">
        <p class="legend__h cond">{L.legend}</p>
        <ul>
          {STATUSES.map((s) => (
            <li><span class={`stchip stchip--${s}`}>{STATUS_LABEL[s][lang]}</span> <span>{STATUS_LABEL[s].hint[lang]}</span></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <nav class="jump wrap" aria-label={L.jump}>
    <div class="filter-row">
      {L.nav.map((n, i) => <a class="filter-btn" href={`#${IDS[i]}`}>{n}</a>)}
    </div>
  </nav>

  <!-- KACHELN -->
  <section id="blick" class="section--tight wrap" aria-labelledby="h-blick">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>01</b> / {L.kpiK}</p>
        <h2 id="h-blick" class="sec-head__title display">{L.kpiH[0]} <span class="grad-text">{L.kpiH[1]}</span></h2>
      </div>
    </div>
    <div class="kpis">
      {KPIS.map((k, i) => (
        <article class={`card kpi kpi--${k.status} intro`} style={`--d:${0.04 * i}s`}>
          <span class={`stchip stchip--${k.status}`} title={STATUS_LABEL[k.status].hint[lang]}>{STATUS_LABEL[k.status][lang]}</span>
          <p class="kpi__num display"><span class="grad-text">{k.big[lang]}</span>{k.unit && k.unit[lang] && <small>{k.unit[lang]}</small>}</p>
          <h3 class="kpi__label cond">{k.label[lang]}</h3>
          {k.note && <p class="kpi__note">{k.note[lang]}</p>}
          <p class="kpi__meta">
            <span>{L.asOf} {fmtDay(lang, k.asOf)}</span>
            <span>{k.src.map((id, j) => <>{j > 0 && ', '}<a href={SOURCES[id].url} target="_blank" rel="noopener">{SOURCES[id].short}</a></>)}</span>
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- VERKÄUFE -->
  <section id="verkaeufe" class="section--tight wrap" aria-labelledby="h-verkaeufe">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>02</b> / {L.salesK}</p>
        <h2 id="h-verkaeufe" class="sec-head__title display">{L.salesH[0]} <span class="grad-text">{L.salesH[1]}</span></h2>
      </div>
    </div>
    <p class="lead-box" data-reveal><Icon name="bolt" size={20} /> <span>{L.salesLead}</span></p>
    <StatTable rows={SALES} caption={L.salesK} />
  </section>

  <!-- PROGNOSEN -->
  <section id="prognosen" class="section--tight wrap" aria-labelledby="h-prognosen">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>03</b> / {L.foreK}</p>
        <h2 id="h-prognosen" class="sec-head__title display">{L.foreH[0]} <span class="grad-text">{L.foreH[1]}</span></h2>
      </div>
    </div>
    <p class="muted sec-lead">{L.foreLead}</p>
    <StatTable rows={FORECASTS} caption={L.foreK} />
  </section>

  <!-- VERGLEICH -->
  <section id="vergleich" class="section--tight wrap" aria-labelledby="h-vergleich">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>04</b> / {L.cmpK}</p>
        <h2 id="h-vergleich" class="sec-head__title display">{L.cmpH[0]} <span class="grad-text">{L.cmpH[1]}</span></h2>
      </div>
      <p class="gap"><span class="gap__n display grad-text">{fmtN(waitDays)}</span><span class="gap__t cond">{L.gap}</span></p>
    </div>
    <p class="muted sec-lead">{L.cmpLead}</p>
    <div class="cmp-wrap">
      <table class="cmp">
        <caption class="sr-only">{L.cmpH.join(' ')}</caption>
        <thead><tr><th scope="col">{L.cmpMetric}</th><th scope="col">GTA V <small>2013</small></th><th scope="col">GTA VI <small>2026</small></th></tr></thead>
        <tbody>
          {COMPARE.map((r) => (
            <tr>
              <th scope="row">{r.label[lang]}</th>
              {[r.v, r.vi].map((c, ci) => (
                <td data-l={ci === 0 ? 'GTA V' : 'GTA VI'} class:list={[`is-${c.status}`, { 'is-vi': ci === 1 }]}>
                  <span class="cmp__v">{c.value[lang]}</span>
                  <span class="cmp__m">
                    <span class={`stchip stchip--${c.status}`}>{STATUS_LABEL[c.status][lang]}</span>
                    {c.src.map((id) => <a href={SOURCES[id].url} target="_blank" rel="noopener">{SOURCES[id].short}</a>)}
                  </span>
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <h3 class="sub-h cond">{L.seriesH}</h3>
    <div class="series">
      {SERIES.map((s, i) => (
        <div class="card series__i" data-reveal style={`--d:${i * 0.05}s`}>
          <span class="series__v display">{s.value[lang]}</span>
          <span class="series__l cond">{s.label[lang]}</span>
          <span class="series__m">{L.asOf} {fmtDay(lang, s.asOf)} · {s.src.map((id) => <a href={SOURCES[id].url} target="_blank" rel="noopener">{SOURCES[id].short}</a>)}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- RELEASE & TECHNIK -->
  <section id="release" class="section--tight wrap" aria-labelledby="h-release">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>05</b> / {L.relK}</p>
        <h2 id="h-release" class="sec-head__title display">{L.relH[0]} <span class="grad-text">{L.relH[1]}</span></h2>
      </div>
    </div>
    <p class="muted sec-lead">{L.relLead}</p>
    <StatTable rows={RELEASE} caption={L.relK} />
  </section>

  <!-- TRAILER -->
  <section id="trailer" class="section--tight wrap" aria-labelledby="h-trailer">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>06</b> / {L.trK}</p>
        <h2 id="h-trailer" class="sec-head__title display">{L.trH[0]}<span class="grad-text">{L.trH[1]}</span></h2>
      </div>
    </div>
    <p class="muted sec-lead">{L.trLead}</p>
    <div class="trailers">
      {TRAILERS.map((tr, i) => (
        <article class="card trc" data-reveal style={`--d:${i * 0.05}s`}>
          <p class="trc__date cond">{L.trDate} {fmtDay(lang, tr.date)}</p>
          <h3 class="trc__name display">{tr.name[lang]}</h3>
          <p class="trc__k cond">{tr.first.label[lang]}</p>
          <p class="trc__v">{tr.first.value[lang]}</p>
          {tr.first.note && <p class="trc__n">{tr.first.note[lang]}</p>}
          <p class="trc__meta">
            <span class={`stchip stchip--${tr.first.status}`}>{STATUS_LABEL[tr.first.status][lang]}</span>
            {tr.first.src.map((id) => <a href={SOURCES[id].url} target="_blank" rel="noopener">{SOURCES[id].short}</a>)}
          </p>
          <a class="trc__yt" href={SOURCES[tr.yt].url} target="_blank" rel="noopener">
            <Icon name="play" size={14} /> {L.trToday}: <b>{fmtM(tr.views)}</b>
          </a>
        </article>
      ))}
    </div>

    <figure class="card bars" data-reveal>
      <figcaption class="bars__h">
        <span class="cond">{L.barsH}</span>
        <span class={`stchip stchip--own`}>{STATUS_LABEL.own[lang]}</span>
      </figcaption>
      <ol class="bars__list">
        {trailersByViews.map((tr) => (
          <li title={`${tr.name[lang]}: ${fmtN(tr.views)}`}>
            <span class="bars__name">{tr.name[lang]}</span>
            <span class="bars__track" aria-hidden="true"><span class="bars__fill" style={`--w:${((tr.views / maxViews) * 100).toFixed(1)}%`}></span></span>
            <span class="bars__val">{fmtN(tr.views)}</span>
          </li>
        ))}
      </ol>
      <p class="bars__total"><span class="cond">{L.barsTotal}</span> <b class="display">{fmtM(totalViews)}</b></p>
      <p class="bars__note">{L.barsNote(fmtTime(VIEWS_AS_OF))}</p>
    </figure>
  </section>

  <!-- ENTWICKLUNG -->
  <section id="entwicklung" class="section--tight wrap" aria-labelledby="h-entwicklung">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>07</b> / {L.devK}</p>
        <h2 id="h-entwicklung" class="sec-head__title display">{L.devH[0]} <span class="grad-text">{L.devH[1]}</span></h2>
      </div>
    </div>
    <p class="muted sec-lead">{L.devLead}</p>
    <StatTable rows={devRows} caption={L.devK} />
  </section>

  <!-- SPIELWELT -->
  <section id="spielwelt" class="section--tight wrap" aria-labelledby="h-spielwelt">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>08</b> / {L.worldK}</p>
        <h2 id="h-spielwelt" class="sec-head__title display">{L.worldH[0]} <span class="grad-text">{L.worldH[1]}</span></h2>
      </div>
    </div>
    <p class="muted sec-lead">{L.worldLead}</p>
    <StatTable rows={WORLD} caption={L.worldK} />
  </section>

  <!-- WERTUNGEN -->
  <section id="wertungen" class="section--tight wrap" aria-labelledby="h-wertungen">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>09</b> / {L.revK}</p>
        <h2 id="h-wertungen" class="sec-head__title display">{L.revH[0]}<span class="grad-text">{L.revH[1]}</span></h2>
      </div>
    </div>
    <p class="muted sec-lead">{L.revLead}</p>
    <StatTable rows={REVIEWS} caption={L.revK} />
  </section>

  <!-- ZEITSTRAHL -->
  <section id="zeitstrahl" class="section--tight wrap" aria-labelledby="h-zeitstrahl">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>10</b> / {L.tlK}</p>
        <h2 id="h-zeitstrahl" class="sec-head__title display">{L.tlH[0]} <span class="grad-text">{L.tlH[1]}</span></h2>
      </div>
    </div>
    <ol class="tl">
      {TIMELINE.map((m, i) => {
        const future = m.date > buildDay;
        const isToday = m.date === buildDay;
        return (
          <li class:list={[`tl--${m.kind}`, { 'is-next': future, 'is-today': isToday }]} data-date={m.date} data-reveal style={`--d:${(i % 4) * 0.04}s`}>
            <time class="tl__d cond" datetime={m.date}>{fmtDay(lang, m.date)}</time>
            <span class="tl__dot" aria-hidden="true"></span>
            <div class="tl__b">
              <p class="tl__t">{m.title[lang]} <span class="chip chip--rumor tl__soon">{L.soon}</span><span class="chip chip--live tl__today">{L.today}</span></p>
              <p class="tl__x">{m.text[lang]}</p>
              <p class="tl__s">{m.src.map((id, j) => <>{j > 0 && ', '}<a href={SOURCES[id].url} target="_blank" rel="noopener">{SOURCES[id].short}</a></>)}</p>
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- WIRD LAUFEND AKTUALISIERT -->
  <section id="updates" class="section--tight wrap" aria-labelledby="h-updates">
    <div class="upd card">
      <div class="upd__main">
        <p class="sec-head__kicker cond"><span class="chip chip--live"><span class="dot-live"></span>{L.live}</span> {L.updK}</p>
        <h2 id="h-updates" class="upd__h display">{L.updH[0]} <span class="grad-text">{L.updH[1]}</span></h2>
        <p class="upd__asof cond">{L.updAsOf}: <time datetime={UPDATED}>{fmtTime(UPDATED)}</time></p>
        <p class="muted">{L.updText}</p>
        <div class="upd__cta">
          <a class="btn btn--discord" {...discordFor(lang)}><Icon name="discord" /> {L.discord}</a>
          <a class="btn btn--ghost" href={h('/news/')}><Icon name="news" /> {L.news}</a>
        </div>
      </div>
      <div class="upd__side">
        <p class="upd__k cond">{L.updNext}</p>
        <ul class="upd__next">{NEXT_UP.map((n) => <li><Icon name="clock" size={16} /> <span>{n[lang]}</span></li>)}</ul>
        <p class="upd__k cond">{L.updLog}</p>
        <ul class="upd__log">{CHANGELOG.map((c) => <li><time datetime={c.at}>{fmtTime(c.at)}</time> <span>{c.text[lang]}</span></li>)}</ul>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="section--tight wrap" aria-labelledby="h-faq">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>11</b> / {L.faqK}</p>
        <h2 id="h-faq" class="sec-head__title display">{L.faqH[0]} <span class="grad-text">{L.faqH[1]}</span></h2>
      </div>
    </div>
    <div class="faq">
      {FAQ.map((f, i) => (
        <details class="faq__i" open={i === 0}>
          <summary class="cond">{f.q[lang]}<Icon name="chevron" size={18} /></summary>
          <p>{f.a[lang]}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- QUELLEN -->
  <section id="quellen" class="section--tight wrap" aria-labelledby="h-quellen">
    <div class="sec-head">
      <div>
        <p class="sec-head__kicker cond"><b>12</b> / {L.srcK}</p>
        <h2 id="h-quellen" class="sec-head__title display">{L.srcH[0]} <span class="grad-text">{L.srcH[1]}</span></h2>
      </div>
    </div>
    <p class="muted sec-lead">{L.srcLead(sourceList.length)}</p>
    <ol class="srcs">
      {sourceList.map(([id, s]) => (
        <li id={`q-${id}`}>
          <a href={s.url} target="_blank" rel="noopener">{s.name}</a>
          <span class="srcs__d">{fmtDay(lang, s.date)}</span>
        </li>
      ))}
    </ol>
    <p class="disclaimer"><Icon name="shield" size={18} /> <span>{L.disclaimer}</span></p>
  </section>
</Base>

<script>
  // Zeitstrahl: "Heute" / "Demnächst" nach dem aktuellen Tag (deutsche Zeit) setzen, nicht nach dem Build-Tag
  const markTimeline = () => {
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Berlin' }).format(new Date());
    document.querySelectorAll<HTMLElement>('.tl li[data-date]').forEach((li) => {
      const d = li.dataset.date ?? '';
      li.classList.toggle('is-today', d === today);
      li.classList.toggle('is-next', d > today);
    });
  };
  document.addEventListener('astro:page-load', markTimeline);
</script>

