---
import Base from './Base.astro';
import Photo from '../components/Photo.astro';
import { getImage } from 'astro:assets';
import { photoFor } from '../data/photos';
import Icon from '../components/Icon.astro';
import Stars from '../components/Stars.astro';
import NewsCard from '../components/NewsCard.astro';
import GuideCard from '../components/GuideCard.astro';
import { getGame } from '../data/games';
import { catL } from '../data/categories';
import { readingTime, altArticlePath, type News, type Guide } from '../lib/utils';
import { SITE, discordFor } from '../config';
import { langFromUrl, useT, href, fmtDateL, LOCALE } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = useT(lang);
const h = (p: string) => href(lang, p);

interface Props {
  kind: 'news' | 'guide';
  entry: News | Guide;
  headings: { depth: number; slug: string; text: string }[];
  related: (News | Guide)[];
}
const { kind, entry, headings, related } = Astro.props;
const d = entry.data as News['data'] & Guide['data'];
const g = getGame(d.game);
const cat = kind === 'guide' ? catL(d.category, lang) : null;
const alt = await altArticlePath(kind, entry, lang);
const url = new URL(Astro.url.pathname, Astro.site ?? SITE.url).toString();
const minutes = readingTime(entry.body);
const toc = headings.filter((h) => h.depth === 2);
const modified = d.updatedDate ?? d.pubDate;
// Vorschaubild 1200x675 (16:9) fuer Google Discover, Social Media und strukturierte Daten
const photoTags = kind === 'news' ? [d.game] : [d.category, d.game];
const photoSeed = ('translationOf' in d && d.translationOf) || entry.id;
const poolPhoto = d.image ? null : photoFor(photoSeed, photoTags);
const ogImage = d.image
  ? d.image.src
  : (await getImage({ src: poolPhoto!.src, width: 1200, height: 675, format: 'jpg', quality: 82, fit: 'cover' })).src;
const ogAbs = new URL(ogImage, Astro.site ?? SITE.url).toString();
const photoCredit = d.image?.credit ?? t.article.photo;
const section = kind === 'news' ? { href: h('/news/'), label: t.nav.news } : { href: h('/guides/'), label: t.nav.guides };

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': kind === 'news' ? 'NewsArticle' : 'Article',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: modified.toISOString(),
    inLanguage: LOCALE[lang],
    mainEntityOfPage: url,
    image: [ogAbs],
    author: { '@type': 'Organization', name: d.author, url: SITE.url },
    publisher: { '@type': 'Organization', name: SITE.name, logo: { '@type': 'ImageObject', url: `${SITE.url}/favicon.svg` } },
    about: { '@type': 'VideoGame', name: g.full },
    ...(d.sources?.length ? { citation: d.sources.map((s) => s.url) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.article.home, item: `${SITE.url}${h('/')}` },
      { '@type': 'ListItem', position: 2, name: section.label, item: `${SITE.url}${section.href}` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
if (d.faq?.length) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
const shareText = encodeURIComponent(d.title);
const shareUrl = encodeURIComponent(url);
---
<Base title={d.title} description={d.description} type="article" image={ogImage} published={d.pubDate} modified={modified} jsonLd={jsonLd} alt={alt}>
  <article class="art" style={`--g-from:${g.from};--g-to:${g.to}`}>
    <header class="art__head wrap">
      <nav class="crumbs" aria-label={t.nav.crumbs}>
        <a href={h('/')}>{t.article.home}</a><span aria-hidden="true">/</span>
        <a href={section.href}>{section.label}</a><span aria-hidden="true">/</span>
        <a href={h(`/spiele/${g.slug}/`)}>{g.name}</a>
      </nav>
      <div class="art__chips">
        <a href={h(`/spiele/${g.slug}/`)} class="chip chip--game">{g.name}</a>
        {cat && <a href={h(`/guides/kategorie/${cat.slug}/`)} class="chip">{cat.label}</a>}
        {d.breaking && <span class="chip chip--live"><span class="dot-live"></span>{t.card.breaking}</span>}
        {d.rumor && <span class="chip chip--rumor">{t.article.rumorChip}</span>}
        {d.bot && <span class="chip chip--bot">{kind === 'news' ? t.article.newsBot : t.article.radarBot}</span>}
      </div>
      <h1 class="art__title display">{d.title}</h1>
      <p class="art__lead">{d.description}</p>
      <div class="art__meta cond">
        <span><Icon name="user" size={15} /> {d.author}</span>
        <span><Icon name="clock" size={15} /> <time datetime={d.pubDate.toISOString()}>{fmtDateL(lang, d.pubDate, kind === 'news')}</time></span>
        {d.updatedDate && <span>{t.article.updated} {fmtDateL(lang, d.updatedDate)}</span>}
        <span>{minutes} {t.article.minRead}</span>
        {kind === 'news' && <span>Hype <Stars value={d.hype} /></span>}
        {d.difficulty && <span>{t.article.difficulty}: {t.difficulty[d.difficulty]}</span>}
      </div>
    </header>

    <div class="art__cover wrap" data-reveal>
      <figure class="art__cover-in">
        <Photo seed={photoSeed} tags={photoTags} override={d.image} eager sizes="(max-width: 1240px) 100vw, 1200px" widths={[640, 960, 1280, 1600]} />
        <figcaption class="cond">{photoCredit}</figcaption>
      </figure>
    </div>

    <div class="art__grid wrap">
      <aside class="art__aside">
        {toc.length > 1 && (
          <nav class="toc" aria-label={t.article.toc}>
            <p class="cond">{t.article.toc}</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="share">
          <p class="cond">{t.article.share}</p>
          <div class="share__row">
            <a href={`https://wa.me/?text=${shareText}%20${shareUrl}`} target="_blank" rel="noopener" aria-label={t.article.shareWa}><Icon name="whatsapp" /></a>
            <a href={`https://www.reddit.com/submit?url=${shareUrl}&title=${shareText}`} target="_blank" rel="noopener" aria-label={t.article.shareReddit}><Icon name="reddit" /></a>
            <a href={`https://x.com/intent/post?text=${shareText}&url=${shareUrl}`} target="_blank" rel="noopener" aria-label={t.article.shareX}><Icon name="xlogo" /></a>
            <a href={`https://www.pinterest.com/pin/create/button/?url=${shareUrl}&description=${shareText}`} target="_blank" rel="noopener" aria-label={t.article.sharePin}><Icon name="pinterest" /></a>
            <button data-share aria-label={t.article.shareCopy}><Icon name="link" /></button>
          </div>
        </div>
      </aside>

      <div class="art__main">
        <div class="prose">
          <slot />
        </div>

        {d.faq && d.faq.length > 0 && (
          <section class="faq" aria-labelledby="faq-h">
            <h2 id="faq-h" class="display">{t.article.faq}</h2>
            {d.faq.map((f, i) => (
              <div class:list={['faq__item', { 'is-open': i === 0 }]} data-acc>
                <button aria-expanded={i === 0 ? 'true' : 'false'}>
                  <span>{f.q}</span><Icon name="chevron" />
                </button>
                <div class="faq__a"><p>{f.a}</p></div>
              </div>
            ))}
          </section>
        )}

        {d.helpers && d.helpers.length > 0 && (
          <section class="sources" aria-label={t.article.thanks}>
            <p class="cond">{t.article.thanks}</p>
            <p class="sources__note">{t.article.thanksText(d.helpers.map((x) => x.name).join(', '))}</p>
          </section>
        )}

        {d.sources && d.sources.length > 0 && (
          <section class="sources" aria-label={t.article.sources}>
            <p class="cond">{t.article.sources}</p>
            <ul>
              {d.sources.map((s) => (
                <li><a href={s.url} target="_blank" rel="noopener nofollow">{s.name} <Icon name="arrow" size={14} /></a></li>
              ))}
            </ul>
            <p class="sources__note">
              {kind === 'news' ? t.article.noteNews : t.article.noteGuide}
              {d.rumor && t.article.rumorNote}
            </p>
            {d.bot && (
              <p class="sources__ai">
                <Icon name="bolt" size={14} /> {kind === 'news' ? t.article.aiNews : t.article.aiGuide}
              </p>
            )}
          </section>
        )}

        <a {...discordFor(lang)} class="cta-discord">
          <Icon name="discord" size={34} />
          <span><b class="display">{t.article.discordTitle}</b><small>{t.article.discordText}</small></span>
          <Icon name="arrow" />
        </a>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section wrap" aria-labelledby="rel-h">
      <div class="sec-head">
        <h2 id="rel-h" class="sec-head__title display">{t.article.more} <span class="grad-text">{g.name}</span></h2>
      </div>
      <div class="rel-grid">
        {related.map((r, i) =>
          r.collection.startsWith('news') ? <NewsCard item={r as News} delay={i * 0.05} /> : <GuideCard item={r as Guide} delay={i * 0.05} />,
        )}
      </div>
    </section>
  )}
</Base>

<style>
  .art__head { padding-top: clamp(30px, 5vw, 64px); max-width: 1000px; margin-inline: auto; }
  .art__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 18px; }
  .art__title { font-size: clamp(2.5rem, 6.5vw, 5.2rem); line-height: 0.95; }
  .art__lead { font-size: clamp(1.1rem, 1.8vw, 1.35rem); color: #ddd6e8; margin: 22px 0; max-width: 820px; line-height: 1.5; }
  .art__meta { display: flex; flex-wrap: wrap; gap: 8px 20px; color: var(--muted); font-size: 0.85rem; padding-bottom: 6px; }
  .art__meta span { display: inline-flex; align-items: center; gap: 6px; }
  .art__cover { margin-top: 30px; max-width: 1200px; }
  .art__cover-in {
    position: relative; margin: 0;
    aspect-ratio: 21 / 8; overflow: hidden; border: 1px solid var(--line);
    clip-path: polygon(0 0, 100% 0, 100% calc(100% - 24px), calc(100% - 24px) 100%, 0 100%);
  }
  .art__cover-in figcaption {
    position: absolute; right: 26px; bottom: 10px;
    font-size: 0.7rem; color: rgba(255, 255, 255, 0.75);
    background: rgba(0, 0, 0, 0.45); padding: 3px 8px;
  }
  .art__grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 760px);
    justify-content: center;
    gap: clamp(30px, 5vw, 70px);
    margin-top: clamp(30px, 5vw, 60px);
  }
  .art__aside { position: relative; }
  .toc, .share { position: sticky; top: calc(var(--header-h) + var(--ticker-h) + 24px); }
  .toc { margin-bottom: 30px; }
  .toc p, .share p { color: var(--dim); font-size: 0.8rem; margin: 0 0 10px; }
  .toc ol { list-style: none; margin: 0; padding: 0; border-left: 1px solid var(--line2); counter-reset: t; }
  .toc li { counter-increment: t; }
  .toc a {
    display: block; padding: 7px 0 7px 16px; margin-left: -1px;
    border-left: 2px solid transparent;
    color: var(--muted); font-size: 0.92rem; line-height: 1.35;
    transition: color 0.2s, border-color 0.2s;
  }
  .toc a::before { content: counter(t, decimal-leading-zero) ' '; font-family: var(--f-cond); color: var(--dim); font-weight: 700; }
  .toc a:hover { color: var(--text); border-color: var(--pink); }
  .share { top: auto; }
  .share__row { display: flex; gap: 6px; flex-wrap: wrap; }
  .share__row a, .share__row button {
    width: 40px; height: 40px; display: grid; place-items: center;
    border: 1px solid var(--line2); color: var(--muted); transition: color 0.2s, border-color 0.2s;
  }
  .share__row a:hover, .share__row button:hover { color: var(--text); border-color: var(--pink); }
  .share__row :global(.is-copied) { background: var(--teal); color: #041512; border-color: var(--teal); }

  .faq { margin-top: 3em; }
  .faq h2 { font-size: clamp(1.8rem, 3.4vw, 2.4rem); margin-bottom: 16px; }
  .faq__item { border: 1px solid var(--line); background: var(--panel); margin-bottom: 8px; }
  .faq__item button {
    width: 100%; display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 16px 18px; text-align: left; font-weight: 600; font-size: 1.05rem;
  }
  .faq__item button :global(svg) { flex: none; transition: transform 0.3s var(--ease); color: var(--pink); }
  .faq__item.is-open button :global(svg) { transform: rotate(90deg); }
  .faq__a { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.35s var(--ease); }
  .faq__a p { overflow: hidden; margin: 0; padding: 0 18px; color: var(--muted); }
  .faq__item.is-open .faq__a { grid-template-rows: 1fr; }
  .faq__item.is-open .faq__a p { padding-bottom: 16px; }

  .sources { margin-top: 3em; padding: 20px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.02); }
  .sources p.cond { margin: 0 0 10px; color: var(--dim); font-size: 0.8rem; }
  .sources ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .sources a { display: inline-flex; align-items: center; gap: 6px; padding: 6px 10px; border: 1px solid var(--line2); font-size: 0.92rem; }
  .sources a:hover { border-color: var(--teal); color: var(--teal); }
  .sources__note { margin: 12px 0 0; font-size: 0.85rem; color: var(--dim); }
  .sources__ai { display: flex; gap: 8px; align-items: flex-start; margin: 10px 0 0; padding: 10px 12px; font-size: 0.85rem; color: var(--teal); background: rgba(25, 227, 200, 0.06); border: 1px solid rgba(25, 227, 200, 0.2); }
  .sources__ai :global(svg) { flex: none; margin-top: 3px; }

  .cta-discord {
    margin-top: 2.5em;
    display: flex; align-items: center; gap: 18px;
    padding: 20px 22px;
    background: linear-gradient(120deg, rgba(88, 101, 242, 0.3), rgba(88, 101, 242, 0.08));
    border: 1px solid rgba(88, 101, 242, 0.5);
    transition: transform 0.25s var(--ease);
  }
  .cta-discord:hover { transform: translateY(-3px); }
  .cta-discord span { flex: 1; display: flex; flex-direction: column; }
  .cta-discord b { font-weight: 400; font-size: 1.6rem; }
  .cta-discord small { color: #cfd3ff; }

  .rel-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }

  @media (max-width: 1000px) {
    .art__grid { grid-template-columns: minmax(0, 1fr); }
    .art__aside { order: 2; }
    .toc { display: none; }
    .share { position: static; }
    .rel-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) { .art__cover-in { aspect-ratio: 16 / 9; } }
</style>
