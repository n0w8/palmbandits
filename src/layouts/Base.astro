---
// Nur Latin-Zeichensatz (reicht für Deutsch inkl. Umlaute) = kleinere CSS, schnellere Seite
import '@fontsource/anton/latin-400.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '@fontsource/barlow/latin-700.css';
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '../styles/global.css';
import antonUrl from '@fontsource/anton/files/anton-latin-400-normal.woff2?url';
import { ClientRouter } from 'astro:transitions';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Ticker from '../components/Ticker.astro';
import Footer from '../components/Footer.astro';
import MobileNav from '../components/MobileNav.astro';
import RadioPlayer from '../components/RadioPlayer.astro';
import SearchModal from '../components/SearchModal.astro';
import { langFromUrl, useT } from '../i18n';
const lang = langFromUrl(Astro.url);
const t = useT(lang);

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  alt?: string | null;
}
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add('js')</script>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07060b" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={antonUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <Seo {...Astro.props} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip cond" href="#main">{t.nav.skip}</a>
    <Header alt={Astro.props.alt} />
    <Ticker />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <MobileNav />
    <RadioPlayer />
    <SearchModal />
    <script src="../scripts/app.ts"></script>
    <style>
      .skip {
        position: fixed; left: 12px; top: -60px; z-index: 200;
        background: var(--text); color: var(--bg); padding: 10px 14px;
      }
      .skip:focus { top: 12px; }
    </style>
  </body>
</html>
